{
  "name": "weather-track-pro",
  "version": "1.0.0",
  "description": "5PERF Mini-Project",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "node --experimental-loader ts-node/esm ./src/index.ts",
    "start:watch": "node --inspect --watch --experimental-loader ts-node/esm ./src/index.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "node --experimental-loader ts-node/esm ./src/db/migrate-cli.ts",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js tests/integration --runInBand",
    "bench:seed": "node bench/seed.mjs",
    "bench:run": "node bench/run.mjs",
    "bench:compare": "node bench/compare.mjs"
  },
  "author": "SUPINFO",
  "license": "ISC",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/compression": "^1.8.1",
    "@types/config": "^3.3.3",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.10.9",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.8.2",
    "config": "^3.3.9",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zod-express-middleware": "^1.4.0"
  }
}
